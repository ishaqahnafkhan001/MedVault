{
  "name": "@medvault/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@medvault/database": "workspace:*",
    "@medvault/medical": "workspace:*",
    "@medvault/shared": "workspace:*",
    "@sentry/node": "10.69.0",
    "@supabase/supabase-js": "2.112.2",
    "bullmq": "6.0.8",
    "cors": "2.8.6",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "express-rate-limit": "8.3.0",
    "file-type": "21.3.0",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "multer": "2.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
