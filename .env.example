# Runtime mode. Use production only with production service URLs.
NODE_ENV="development"

# Shared hosted infrastructure. Copy the exact connection strings from the providers.
# On IPv4-only development networks, use the Supabase Session pooler on port 5432.
DATABASE_URL="postgresql://postgres.your-project-ref:your-percent-encoded-password@your-session-pooler-host:5432/postgres?sslmode=require"
MEDVAULT_ALLOW_LOCAL_DATABASE="false"
# Use the complete Redis Cloud URL and keep its database path. Production requires rediss://.
REDIS_URL="rediss://default:your-password@your-redis-cloud-host:6380/0"
MEDVAULT_ALLOW_LOCAL_REDIS="false"

# Server-only Supabase configuration. Never expose the service-role key to the browser.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="medical-documents"

# Public browser configuration. NEXT_PUBLIC_* values are included in the web bundle.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-or-publishable-key"
# Each browser calls the API running on the same local computer.
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Next.js builds with NODE_ENV=production even when the app will run only on this computer.
NEXT_PUBLIC_ALLOW_LOCAL_API="true"

# API
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
MAX_UPLOAD_BYTES="15728640"
SIGNED_URL_TTL_SECONDS="300"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
# Defaults to memory outside production and Redis in production.
RATE_LIMIT_BACKEND="memory"
# Development may fail open; production defaults to fail closed.
RATE_LIMIT_FAIL_OPEN="true"
REPORT_STALE_AFTER_SECONDS="900"
REPORT_RECONCILE_INTERVAL_SECONDS="60"
REPORT_RECONCILE_BATCH_SIZE="100"
REPORT_MAX_PROCESSING_ATTEMPTS="8"

# Worker / Gemini. Blank keeps the development worker idle; production requires a real key.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
REPORT_QUEUE_CONCURRENCY="2"

# Optional monitoring. Leave blank for no-op behavior.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
