# Shared database and infrastructure
DATABASE_URL=""
REDIS_URL="redis://localhost:6379"

# Supabase (create a private bucket named medical-documents)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="medical-documents"

# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""""
NEXT_PUBLIC_API_URL="http://localhost:4000"

# API
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
MAX_UPLOAD_BYTES="15728640"
SIGNED_URL_TTL_SECONDS="300"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"

# Worker / Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
REPORT_QUEUE_CONCURRENCY="2"

# Optional monitoring. Leave blank for no-op behavior.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
